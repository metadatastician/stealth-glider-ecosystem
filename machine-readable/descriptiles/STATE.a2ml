[metadata]
project = "stealth-glider-ecosystem"
version = "0.1.0"
last-updated = "2026-09-02"
status = "active"

[project-context]
name = "Stealth Glider Ecosystem"
purpose = "Coordination hub for the Stealth Glider line: holds the canonical seven-stage chain, the membership manifest and the series roadmap. Manifest only; the games live in their own repositories."
# The manifest and gate exist; the remote half of the gate (every member on
# GitHub carrying the chain) is proven only once the members are published.
completion-percentage = 50

[position]
phase = "implementation"
maturity = "experimental"

[route-to-mvp]
milestones = [
  { name = "Canonical chain, membership manifest and series roadmap", completion = 100 },
  { name = "Offline membership gate with negative control", completion = 100 },
  { name = "All seven members published and carrying the chain (remote gate green)", completion = 0 },
]

[blockers-and-issues]
issues = [
  "Remote membership check is red until the four reserved members are created on GitHub and the three shipped members merge their lineage edits.",
]

[critical-next-actions]
actions = [
  "Create the four reserved member repositories and merge the lineage pull requests in f19, f117a and sr71.",
  "Register the hub and all seven members in gv-clade-index (owner action).",
]

[ecosystem]
part-of = ["Metadatastician estate", "Stealth Glider line", "RSR Framework"]
depends-on = []
