#
# ANCHOR.a2ml - authoritative anchor for this repository

[metadata]
version = "1.0.0"
last-updated = "2026-09-02"

[anchor]
schema = "hyperpolymath.anchor/1"
repo = "metadatastician/stealth-glider-ecosystem"
authority = "coordination-hub"

purpose = [
  "Hold the canonical chain string for the Stealth Glider line.",
  "Hold the membership manifest that every member's ECOSYSTEM.a2ml must agree with.",
  "Hold the series roadmap; members hold their own semantics.",
]

[identity]
project = "Stealth Glider Ecosystem"
kind = "coordination-hub"
one-sentence = "Coordination hub for the Stealth Glider line: holds the canonical seven-stage chain, the membership manifest and the series roadmap. Manifest only; the games live in their own repositories."
domain = "Stealth Glider line: series coordination"

[semantic-authority]
policy = "canonical"

owns = [
  "The canonical chain string ([pipeline] chain in ECOSYSTEM.a2ml)",
  "The membership manifest ([members] in ECOSYSTEM.a2ml)",
  "scripts/check-membership.sh and its negative control",
  "docs/status/ROADMAP.adoc (the series roadmap)",
]

[implementation-policy]
allowed = ["Shell", "Just", "AsciiDoc", "A2ML"]
forbidden = ["Node.js", "npm", "Python"]

[golden-path]
smoke-test-command = ["just test"]

success-criteria = [
  "Placeholder and root-shape gates pass",
  "Offline membership negative control passes",
  "Remote membership check passes once all members are published",
]

[satellite-policy]
# The hub is a manifest, not a specification: members do not pin it.
must-pin-upstream = false
must-declare-authority = true
must-have-anchor = true
must-have-golden-path = true

[semantic-authority-files]
manifest = "machine-readable/descriptiles/ECOSYSTEM.a2ml"
roadmap = "docs/status/ROADMAP.adoc"
gate = "scripts/check-membership.sh"
