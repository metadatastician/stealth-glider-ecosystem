# SPDX-License-Identifier: MPL-2.0

[metadata]
project = "stealth-glider-ecosystem"
ecosystem = "metadatastician"

[position]
type = "coordination-hub"
purpose = "Coordination hub for the Stealth Glider line: holds the canonical seven-stage chain, the membership manifest and the series roadmap. Manifest only; the games live in their own repositories."
what-this-is-not = [
  "a game",
  "a monorepo of the games",
  "a submodule tree",
  "the estate registry (that is gv-clade-index)",
]

[pipeline]
position = "coordination hub (outside the chain)"
chain = "f19-stealth-glider -> f117a-stealth-glider -> sr71-blackglider -> x15-rocket-glider -> planer-1 -> enterglide-ncc-137-k -> tardis-rule-disruption"
notes = "The chain string above is canonical. Every member's own ECOSYSTEM.a2ml must carry it verbatim and name this repository as coordination; scripts/check-membership.sh enforces both."
coordination = "metadatastician/stealth-glider-ecosystem"

[members]
# One entry per chain position, in order. group: shipped | in-progress | reserved.
# member-phase mirrors the member's own CLADE [status] phase at the time of writing.
projects = [
  { order = 1, name = "f19-stealth-glider", display = "Operation Nightstep v2", repo = "metadatastician/f19-stealth-glider", group = "shipped", member-phase = "active", slot = "first Stealth Glider investigation" },
  { order = 2, name = "f117a-stealth-glider", display = "Operation Nightglass", repo = "metadatastician/f117a-stealth-glider", group = "shipped", member-phase = "active", slot = "second Stealth Glider investigation" },
  { order = 3, name = "sr71-blackglider", display = "SR-71 BlackGlider", repo = "metadatastician/sr71-blackglider", group = "in-progress", member-phase = "incubating", slot = "third Stealth Glider investigation" },
  { order = 4, name = "x15-rocket-glider", display = "X15-rocket-glider", repo = "metadatastician/x15-rocket-glider", group = "reserved", member-phase = "reserved", slot = "fourth Stealth Glider investigation" },
  { order = 5, name = "planer-1", display = "Планер-1", repo = "metadatastician/planer-1", group = "reserved", member-phase = "reserved", slot = "fifth Stealth Glider investigation" },
  { order = 6, name = "enterglide-ncc-137-k", display = "Enterglide NCC-137-K", repo = "metadatastician/enterglide-ncc-137-k", group = "reserved", member-phase = "reserved", slot = "sixth Stealth Glider investigation" },
  { order = 7, name = "tardis-rule-disruption", display = "TARDIS", repo = "metadatastician/tardis-rule-disruption", group = "reserved", member-phase = "reserved", slot = "seventh Stealth Glider investigation" },
]

[related-projects]
projects = [
  { name = "rsr-template-repo", relationship = "repository template", notes = "Canonical RSR scaffold from which this repository was minted." },
  { name = "a2ml-ecosystem", relationship = "pattern precedent", notes = "The coordination-hub shape (ANCHOR authority, membership gate, anchor-drift workflow) follows this hub." },
]
